__pycache__/
*.egg-info
.DS_Store

# Eclipse/PyDev: the tracked .project/.pydevproject were 2013-era artifacts
# declaring python 2.7 and were removed. Ignored so PyDev can regenerate them
# locally without them coming back into the tree.
.project
.pydevproject

# uv: the environment is a build artifact, uv.lock is not (it is committed)
.venv/

# Claude Code: skills are tracked, per-session scratch is not
.claude/worktrees/

# Benchmark recording logs: the baseline itself is committed, the run log is not.
benchmarks/recording-*.log
