#!/usr/bin/env bash
# ./verify — the definition of done for this repo.
# Exit 0 means done. Any non-zero exit means not done.
set -euo pipefail
cd "$(dirname "$0")"

# Tool versions come from uv.lock (dev dependency group); `uv run` syncs the
# environment first, so a clean checkout needs nothing but uv on PATH.

start=$(date +%s)
fail=0

stage() {
  local name="$1"; shift
  echo "== $name"
  if ! "$@"; then
    echo "!! $name FAILED"
    fail=1
  fi
}

# Run example.py against a scratch copy of src/ with a freshly built schema.
# The committed src/lob.db is never touched.
smoke() {
  local tmp py rc=0
  # Resolve the project interpreter before cd-ing away: `uv run` inside the
  # scratch dir would look for a project there and miss this one. Without
  # this the smoke stage runs whatever python3 is on PATH, which need not be
  # the version uv.lock pins for the other stages.
  py=$(uv run python -c 'import sys; print(sys.executable)') || return $?
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/pylob-smoke.XXXXXX")
  cp -R src/. "$tmp/"
  rm -f "$tmp/lob.db"
  (
    cd "$tmp"
    "$py" - <<'EOF'
import sqlite3

conn = sqlite3.connect("lob.db")
conn.executescript(open("create_lob.sql").read())
conn.close()
EOF
    "$py" example.py > /dev/null
  ) || rc=$?
  rm -rf "$tmp"
  return $rc
}

# === checks: do not add to this block without asking the user first ===
stage "format" uv run ruff format --check src
stage "lint"   uv run ruff check src
stage "test"   uv run pytest -q tests
stage "smoke"  smoke
# === end checks ===

echo "verify: $(( $(date +%s) - start ))s"
if [ "$fail" -ne 0 ]; then
  echo "verify: FAILED"
  exit 1
fi
echo "verify: OK"
